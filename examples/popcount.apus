// Lookup tables with proven-safe indexing: masking to 8 bits means the compiler
// removes every bounds check, and the value range of the table (0..=8) removes
// every overflow check on the u8 additions.
const POP: [u8; 16] = [0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4];

pure fn popcount8(x: u8) -> u8 {
    return POP[(x & 15) as u64] + POP[(x >> 4) as u64];
}

fn main() io {
    let v = require(io::read_u32(), 0, 255);
    io::println(str(v) ++ " has " ++ str(popcount8(v as u8)) ++ " bits set");
}
