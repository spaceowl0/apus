// run: "2\n" => "2 0 | 20 21 22 | 2 7\n"
// run: "5\n" => "1 2 | 5 6 7 | 2 7\n"
// run: "50\n" => "1 2 | 50 51 52 | 5 9\n"
struct P { x: u32, y: u32 }
struct Box { p: P, tag: u8 }

fn mk(n: u32) -> P {
    if n > 3 { return P { x: 1, y: 2 }; }
    return P { x: n, y: 0 };
}

fn row(n: u32) -> [u32; 3] {
    if n < 3 { return [20, 21, 22]; }
    return [n, n + 1, n + 2];
}

fn boxed(n: u32) -> Box {
    let mut i: u32 = 0;
    while i < 10 bound(10) {
        if i == n { return Box { p: P { x: 2, y: 7 }, tag: 1 }; }
        i += 1;
    }
    return Box { p: P { x: 5, y: 9 }, tag: 0 };
}

fn main() io {
    let n = io::read_u32();
    let p = mk(n);
    let r = row(n);
    let b = boxed(n);
    io::println(str(p.x) ++ " " ++ str(p.y) ++ " | " ++ str(r[0]) ++ " " ++ str(r[1]) ++ " " ++ str(r[2]) ++ " | " ++ str(b.p.x) ++ " " ++ str(b.p.y));
}
