// run: "9.999999 0.000001\n" => "10.000000 9.999998 0.000010 9999999.000000\n3.162278 3.162278 9.999998\n0.000001 9.999999 9.000000 10.000000 9.000000\nge\n1.414214\n0.300000 0.300000\n9\n"
// run: "2000000000.5 1\n" => "2000000001.500000 1999999999.500000 2000000000.500000 2000000000.500000\n3906420.665501 44721.359556 1999999999.500000\n1.000000 2000000000.500000 2000000000.000000 2000000001.000000 2000000000.000000\nge\n1.414214\n0.300000 0.300000\n2000000000\n"
// run: "3000000000.5 2\n" => "3000000002.500000 2999999998.500000 6000000001.000000 1500000000.250000\n5859545.665998 54772.255755 2999999998.500000\n2.000000 3000000000.500000 3000000000.000000 3000000001.000000 3000000000.000000\nge\n1.414214\n0.300000 0.300000\n" trap=arithmetic overflow
// run: "-0.0000006 3\n" => "2.999999 -3.000001 -0.000002 0.000000\n0.001850 nan 3.000001\n-0.000001 3.000000 -1.000000 0.000000 0.000000\nlt\n1.414214\n0.300000 0.300000\n0\n"
