// run: "3.25 1.5\n" => "4.750000 1.750000 4.875000 2.166667\n1.802776 1.802776 1.750000\n1.500000 3.250000 3.000000 4.000000 3.000000\nge\n1.414214\n0.300000 0.300000\n3\n"
