// run: "1.5 2.25\n" => "3.750000 3.375000 0.666667\n3.750000 3.375000\n150 18.750000\n"
// run: "0.1 0.2\n" => "0.300000 0.020000 0.500000\n0.300000 0.020000\n10 1.250000\n"
// run: "3.14159 2.71828\n" => "5.859870 8.539721 1.155727\n5.859870 8.539722\n314 39.250000\n"
// run: "-8.5 0.5\n" => "-8.000000 -4.250000 -17.000000\n-8.000000 -4.250000\n-850 -106.250000\n"
// run: "100000.5 3\n" => "100003.500000 300001.500000 33333.500000\n100003.500000 300001.500000\n10000050 1250006.250000\n"
// run: "1 3\n" => "4.000000 3.000000 0.333333\n4.000000 3.000000\n100 12.500000\n"
// run: "30000000.5 100\n" => "30000100.000000 3000000000.000000 300000.000000\n30000100.000000 3000000000.000000\n" trap=arithmetic overflow
// f32 uses single-precision arithmetic end to end (rounded after every operation).
fn main() io {
    let a = io::read_f32();
    let b = io::read_f32();
    let s = a + b;
    let p = a * b;
    let q = a / b;
    io::println(str(s) ++ " " ++ str(p) ++ " " ++ str(q));
    io::println(str(s as f64) ++ " " ++ str((a as f64) * (b as f64)));
    let n = (a * 100.0) as i32;
    io::println(str(n) ++ " " ++ str((n as f32) / 8.0));
}
