// run: "-7.75 -7.75\n" => "-15.500000 0.000000 60.062500 1.000000\n-3.759577 nan 0.000000\n-7.750000 -7.750000 -8.000000 -7.000000 -7.000000\nge\n1.414214\n0.300000 0.300000\n-7\n"
// IEEE-754 arithmetic. Constants fold with the same code the VM uses; str(float) prints six
// fractional digits (round-half-even), so output is identical on every backend.
pure fn newton(x: f64) -> f64 {
    let mut g = x / 2.0 + 0.5;
    for i in 0..8 { g = (g + x / g) / 2.0; }
    return g;
}

fn main() io {
    let x = io::read_f64();
    let y = io::read_f64();
    io::println(str(x + y) ++ " " ++ str(x - y) ++ " " ++ str(x * y) ++ " " ++ str(x / y));
    io::println(str(newton(x)) ++ " " ++ str(sqrt(x)) ++ " " ++ str(abs(x - y)));
    io::println(str(min(x, y)) ++ " " ++ str(max(x, y)) ++ " " ++ str(floor(x)) ++ " " ++ str(ceil(x)) ++ " " ++ str(trunc(x)));
    if x < y { io::println("lt"); } else { io::println("ge"); }
    if is_nan(x / y) { io::println("nan"); }
    io::println(str(static newton(2.0)));
    let h: f32 = 0.1;
    let s = h + h + h;
    io::println(str(s) ++ " " ++ str(s as f64));
    io::println(str(x as i32));
}
