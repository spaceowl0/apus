// run: "Bob\n2\n" => "len=3\nHello, Bob #1!\nHello, Bob #2!\n"
// run: "Al\n5\n" => "len=2\nHello, Al #1!\nHello, Al #2!\nHello, Al #3!\n"
// run: "Al\n0\n" => "len=2\nHello, Al #1!\n"
// run: "ABCDEFGHIJ\n1\n" => "len=8\nHello, ABCDEFGH #1!\n"
fn greet(name: Str<8>, times: u32 in 1..=3) io {
    for i in 0..times {
        io::println("Hello, " ++ name ++ " #" ++ str(i + 1) ++ "!");
    }
}

fn main() io {
    let name = io::read_line(8);
    let n = io::read_u32();
    io::println("len=" ++ str(len(name)));
    greet(name, clamp(n, 1, 3));
}
